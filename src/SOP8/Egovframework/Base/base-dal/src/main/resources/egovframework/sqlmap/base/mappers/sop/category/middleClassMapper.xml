<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="middleClassMapper">

	<select id="selectMiddleClasses" parameterType="map" resultType="egovframework.base.model.sop.category.MiddleClass">
		Select * from so_ctgry_mclas
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertMiddleClass" parameterType="egovframework.base.model.sop.category.MiddleClass" useGeneratedKeys="true" keyProperty="mclas_sn">
		INSERT INTO so_ctgry_mclas (lclas_sn, mclas_name)
		VALUES (#{lclas_sn}, #{mclas_name})
	</insert>

	<insert id="insertMiddleClasses" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="mclas_sn">
		INSERT INTO so_ctgry_mclas (lclas_sn, mclas_name)
		VALUES
		<foreach collection="list" item="middleClass" separator=",">
			(
				(#{middleClass.lclas_sn}, #{middleClass.mclas_name})
			)
		</foreach>
	</insert>

	<update id="updateMiddleClass" parameterType="egovframework.base.model.sop.category.MiddleClass">
		UPDATE so_ctgry_mclas
		SET lclas_sn = #{lclas_sn}, mclas_name = #{mclas_name}
		<where>
			mclas_sn = #{mclas_sn}
		</where>
	</update>

	<update id="updateMiddleClassByCondition" parameterType="map">
		UPDATE so_ctgry_mclas
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteMiddleClass" parameterType="egovframework.base.model.sop.category.MiddleClass">
		DELETE FROM so_ctgry_mclas
		<where>
			mclas_sn = #{mclas_sn}
		</where>
	</delete>

	<delete id="deleteMiddleClassByCondition" parameterType="map">
		DELETE FROM so_ctgry_mclas
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
