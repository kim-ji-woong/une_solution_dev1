<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="weatherSiteMapper">

	<select id="selectWeatherSites" parameterType="map" resultType="egovframework.base.model.weather.WeatherSite">
		Select * from wt_site
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertWeatherSite" parameterType="egovframework.base.model.weather.WeatherSite">
		INSERT INTO wt_site (wethr_site_sn, name, descp)
		VALUES (#{wethr_site_sn}, #{name}, #{descp})
	</insert>

	<insert id="insertWeatherSites" parameterType="java.util.List">
		INSERT INTO wt_site (wethr_site_sn, name, descp)
		VALUES
		<foreach collection="list" item="weatherSite" separator=",">
			(
				(#{weatherSite.wethr_site_sn}, #{weatherSite.name}, #{weatherSite.descp})
			)
		</foreach>
	</insert>

	<update id="updateWeatherSite" parameterType="egovframework.base.model.weather.WeatherSite">
		UPDATE wt_site
		SET name = #{name}, descp = #{descp}
		<where>
			wethr_site_sn = #{wethr_site_sn}
		</where>
	</update>

	<update id="updateWeatherSiteByCondition" parameterType="map">
		UPDATE wt_site
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteWeatherSite" parameterType="egovframework.base.model.weather.WeatherSite">
		DELETE FROM wt_site
		<where>
			wethr_site_sn = #{wethr_site_sn}
		</where>
	</delete>

	<delete id="deleteWeatherSiteByCondition" parameterType="map">
		DELETE FROM wt_site
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
