<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="facilityManagerRegularMemberMapper">

	<select id="selectFacilityManagerRegularMembers" parameterType="map" resultType="egovframework.base.model.sensor.FacilityManagerRegularMember">
		Select * from fa_sensor_fclty_mgr_rgl_memb
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertFacilityManagerRegularMember" parameterType="egovframework.base.model.sensor.FacilityManagerRegularMember">
		INSERT INTO fa_sensor_fclty_mgr_rgl_memb (fclty_mgr_sn, rgl_memb_sn)
		VALUES (#{fclty_mgr_sn}, #{rgl_memb_sn})
	</insert>

	<insert id="insertFacilityManagerRegularMembers" parameterType="java.util.List">
		INSERT INTO fa_sensor_fclty_mgr_rgl_memb (fclty_mgr_sn, rgl_memb_sn)
		VALUES
		<foreach collection="list" item="facilityManagerRegularMember" separator=",">
			(
				(#{facilityManagerRegularMember.fclty_mgr_sn}, #{facilityManagerRegularMember.rgl_memb_sn})
			)
		</foreach>
	</insert>

	<update id="updateFacilityManagerRegularMemberByCondition" parameterType="map">
		UPDATE fa_sensor_fclty_mgr_rgl_memb
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteFacilityManagerRegularMember" parameterType="egovframework.base.model.sensor.FacilityManagerRegularMember">
		DELETE FROM fa_sensor_fclty_mgr_rgl_memb
		<where>
			fclty_mgr_sn = #{fclty_mgr_sn}, rgl_memb_sn = #{rgl_memb_sn}
		</where>
	</delete>

	<delete id="deleteFacilityManagerRegularMemberByCondition" parameterType="map">
		DELETE FROM fa_sensor_fclty_mgr_rgl_memb
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
