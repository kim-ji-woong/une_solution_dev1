<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="specialCharactorMapper">

	<select id="selectSpecialCharactors" parameterType="map" resultType="egovframework.base.model.sop.config.SpecialCharactor">
		Select * from so_conf_spcl_chrctr
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertSpecialCharactor" parameterType="egovframework.base.model.sop.config.SpecialCharactor">
		INSERT INTO so_conf_spcl_chrctr (spcl_chrctr_sn, cl, contents, descp)
		VALUES (#{spcl_chrctr_sn}, #{cl}, #{contents}, #{descp})
	</insert>

	<insert id="insertSpecialCharactors" parameterType="java.util.List">
		INSERT INTO so_conf_spcl_chrctr (spcl_chrctr_sn, cl, contents, descp)
		VALUES
		<foreach collection="list" item="specialCharactor" separator=",">
			(
				(#{specialCharactor.spcl_chrctr_sn}, #{specialCharactor.cl}, #{specialCharactor.contents}, #{specialCharactor.descp})
			)
		</foreach>
	</insert>

	<update id="updateSpecialCharactor" parameterType="egovframework.base.model.sop.config.SpecialCharactor">
		UPDATE so_conf_spcl_chrctr
		SET cl = #{cl}, contents = #{contents}, descp = #{descp}
		<where>
			spcl_chrctr_sn = #{spcl_chrctr_sn}
		</where>
	</update>

	<update id="updateSpecialCharactorByCondition" parameterType="map">
		UPDATE so_conf_spcl_chrctr
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteSpecialCharactor" parameterType="egovframework.base.model.sop.config.SpecialCharactor">
		DELETE FROM so_conf_spcl_chrctr
		<where>
			spcl_chrctr_sn = #{spcl_chrctr_sn}
		</where>
	</delete>

	<delete id="deleteSpecialCharactorByCondition" parameterType="map">
		DELETE FROM so_conf_spcl_chrctr
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
