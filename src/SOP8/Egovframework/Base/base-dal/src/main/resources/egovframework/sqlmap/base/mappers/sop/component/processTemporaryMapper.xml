<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="processTemporaryMapper">

	<select id="selectProcessTemporaries" parameterType="map" resultType="egovframework.base.model.sop.component.ProcessTemporary">
		Select * from so_compn_procs_tmpr
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertProcessTemporary" parameterType="egovframework.base.model.sop.component.ProcessTemporary">
		INSERT INTO so_compn_procs_tmpr (compn_sn, tmpr_sn)
		VALUES (#{compn_sn}, #{tmpr_sn})
	</insert>

	<insert id="insertProcessTemporaries" parameterType="java.util.List">
		INSERT INTO so_compn_procs_tmpr (compn_sn, tmpr_sn)
		VALUES
		<foreach collection="list" item="processTemporary" separator=",">
			(
				(#{processTemporary.compn_sn}, #{processTemporary.tmpr_sn})
			)
		</foreach>
	</insert>

	<update id="updateProcessTemporaryByCondition" parameterType="map">
		UPDATE so_compn_procs_tmpr
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteProcessTemporary" parameterType="egovframework.base.model.sop.component.ProcessTemporary">
		DELETE FROM so_compn_procs_tmpr
		<where>
			compn_sn = #{compn_sn}, tmpr_sn = #{tmpr_sn}
		</where>
	</delete>

	<delete id="deleteProcessTemporaryByCondition" parameterType="map">
		DELETE FROM so_compn_procs_tmpr
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
