<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="modelMapper">

	<select id="selectModels" parameterType="map" resultType="egovframework.base.model.gltf.Model">
		Select * from sdms_gltf_model
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertModel" parameterType="egovframework.base.model.gltf.Model">
		INSERT INTO sdms_gltf_model (gltf_model_sn, parnts_sn, model_name, site_sn)
		VALUES (#{gltf_model_sn}, #{parnts_sn}, #{model_name}, #{site_sn})
	</insert>

	<insert id="insertModels" parameterType="java.util.List">
		INSERT INTO sdms_gltf_model (gltf_model_sn, parnts_sn, model_name, site_sn)
		VALUES
		<foreach collection="list" item="model" separator=",">
			(
				(#{model.gltf_model_sn}, #{model.parnts_sn}, #{model.model_name}, #{model.site_sn})
			)
		</foreach>
	</insert>

	<update id="updateModel" parameterType="egovframework.base.model.gltf.Model">
		UPDATE sdms_gltf_model
		SET parnts_sn = #{parnts_sn}, model_name = #{model_name}, site_sn = #{site_sn}
		<where>
			gltf_model_sn = #{gltf_model_sn}
		</where>
	</update>

	<update id="updateModelByCondition" parameterType="map">
		UPDATE sdms_gltf_model
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteModel" parameterType="egovframework.base.model.gltf.Model">
		DELETE FROM sdms_gltf_model
		<where>
			gltf_model_sn = #{gltf_model_sn}
		</where>
	</delete>

	<delete id="deleteModelByCondition" parameterType="map">
		DELETE FROM sdms_gltf_model
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
