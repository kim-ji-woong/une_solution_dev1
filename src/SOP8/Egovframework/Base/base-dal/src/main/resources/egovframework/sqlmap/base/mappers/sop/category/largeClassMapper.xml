<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="largeClassMapper">

	<select id="selectLargeClasses" parameterType="map" resultType="egovframework.base.model.sop.category.LargeClass">
		Select * from so_ctgry_lclas
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertLargeClass" parameterType="egovframework.base.model.sop.category.LargeClass" useGeneratedKeys="true" keyProperty="lclas_sn">
		INSERT INTO so_ctgry_lclas (lclas_name, site_sn)
		VALUES (#{lclas_name}, #{site_sn})
	</insert>

	<insert id="insertLargeClasses" parameterType="java.util.List" useGeneratedKeys="true" keyProperty="lclas_sn">
		INSERT INTO so_ctgry_lclas (lclas_name, site_sn)
		VALUES
		<foreach collection="list" item="largeClass" separator=",">
			(
				(#{largeClass.lclas_name}, #{largeClass.site_sn})
			)
		</foreach>
	</insert>

	<update id="updateLargeClass" parameterType="egovframework.base.model.sop.category.LargeClass">
		UPDATE so_ctgry_lclas
		SET lclas_name = #{lclas_name}, site_sn = #{site_sn}
		<where>
			lclas_sn = #{lclas_sn}
		</where>
	</update>

	<update id="updateLargeClassByCondition" parameterType="map">
		UPDATE so_ctgry_lclas
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteLargeClass" parameterType="egovframework.base.model.sop.category.LargeClass">
		DELETE FROM so_ctgry_lclas
		<where>
			lclas_sn = #{lclas_sn}
		</where>
	</delete>

	<delete id="deleteLargeClassByCondition" parameterType="map">
		DELETE FROM so_ctgry_lclas
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
