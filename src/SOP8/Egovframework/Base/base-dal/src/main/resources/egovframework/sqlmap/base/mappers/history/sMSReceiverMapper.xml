<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="sMSReceiverMapper">

	<select id="selectSMSReceivers" parameterType="map" resultType="egovframework.base.model.history.SMSReceiver">
		Select * from his_sms_rcver
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertSMSReceiver" parameterType="egovframework.base.model.history.SMSReceiver">
		INSERT INTO his_sms_rcver (sms_hist_sn, rgl_memb_sn)
		VALUES (#{sms_hist_sn}, #{rgl_memb_sn})
	</insert>

	<insert id="insertSMSReceivers" parameterType="java.util.List">
		INSERT INTO his_sms_rcver (sms_hist_sn, rgl_memb_sn)
		VALUES
		<foreach collection="list" item="sMSReceiver" separator=",">
			(
				(#{sMSReceiver.sms_hist_sn}, #{sMSReceiver.rgl_memb_sn})
			)
		</foreach>
	</insert>

	<update id="updateSMSReceiverByCondition" parameterType="map">
		UPDATE his_sms_rcver
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteSMSReceiver" parameterType="egovframework.base.model.history.SMSReceiver">
		DELETE FROM his_sms_rcver
		<where>
			sms_hist_sn = #{sms_hist_sn}, rgl_memb_sn = #{rgl_memb_sn}
		</where>
	</delete>

	<delete id="deleteSMSReceiverByCondition" parameterType="map">
		DELETE FROM his_sms_rcver
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
