<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="endpointMapper">

	<select id="selectEndpoints" parameterType="map" resultType="egovframework.base.model.sop.component.Endpoint">
		Select * from so_compn_end_point
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertEndpoint" parameterType="egovframework.base.model.sop.component.Endpoint">
		INSERT INTO so_compn_end_point (compn_sn, title, begin_yn, execut_no)
		VALUES (#{compn_sn}, #{title}, #{begin_yn}, #{execut_no})
	</insert>

	<insert id="insertEndpoints" parameterType="java.util.List">
		INSERT INTO so_compn_end_point (compn_sn, title, begin_yn, execut_no)
		VALUES
		<foreach collection="list" item="endpoint" separator=",">
			(
				(#{endpoint.compn_sn}, #{endpoint.title}, #{endpoint.begin_yn}, #{endpoint.execut_no})
			)
		</foreach>
	</insert>

	<update id="updateEndpoint" parameterType="egovframework.base.model.sop.component.Endpoint">
		UPDATE so_compn_end_point
		SET title = #{title}, begin_yn = #{begin_yn}, execut_no = #{execut_no}
		<where>
			compn_sn = #{compn_sn}
		</where>
	</update>

	<update id="updateEndpointByCondition" parameterType="map">
		UPDATE so_compn_end_point
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteEndpoint" parameterType="egovframework.base.model.sop.component.Endpoint">
		DELETE FROM so_compn_end_point
		<where>
			compn_sn = #{compn_sn}
		</where>
	</delete>

	<delete id="deleteEndpointByCondition" parameterType="map">
		DELETE FROM so_compn_end_point
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
