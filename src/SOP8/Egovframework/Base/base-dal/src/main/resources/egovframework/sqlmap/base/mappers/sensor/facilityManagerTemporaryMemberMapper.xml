<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="facilityManagerTemporaryMemberMapper">

	<select id="selectFacilityManagerTemporaryMembers" parameterType="map" resultType="egovframework.base.model.sensor.FacilityManagerTemporaryMember">
		Select * from fa_sensor_fclty_mgr_tmpr_memb
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertFacilityManagerTemporaryMember" parameterType="egovframework.base.model.sensor.FacilityManagerTemporaryMember">
		INSERT INTO fa_sensor_fclty_mgr_tmpr_memb (fclty_mgr_sn, tmpr_memb_sn)
		VALUES (#{fclty_mgr_sn}, #{tmpr_memb_sn})
	</insert>

	<insert id="insertFacilityManagerTemporaryMembers" parameterType="java.util.List">
		INSERT INTO fa_sensor_fclty_mgr_tmpr_memb (fclty_mgr_sn, tmpr_memb_sn)
		VALUES
		<foreach collection="list" item="facilityManagerTemporaryMember" separator=",">
			(
				(#{facilityManagerTemporaryMember.fclty_mgr_sn}, #{facilityManagerTemporaryMember.tmpr_memb_sn})
			)
		</foreach>
	</insert>

	<update id="updateFacilityManagerTemporaryMemberByCondition" parameterType="map">
		UPDATE fa_sensor_fclty_mgr_tmpr_memb
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteFacilityManagerTemporaryMember" parameterType="egovframework.base.model.sensor.FacilityManagerTemporaryMember">
		DELETE FROM fa_sensor_fclty_mgr_tmpr_memb
		<where>
			fclty_mgr_sn = #{fclty_mgr_sn}, tmpr_memb_sn = #{tmpr_memb_sn}
		</where>
	</delete>

	<delete id="deleteFacilityManagerTemporaryMemberByCondition" parameterType="map">
		DELETE FROM fa_sensor_fclty_mgr_tmpr_memb
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
