<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="smallClassUserGradeMapper">

	<select id="selectSmallClassUserGrades" parameterType="map" resultType="egovframework.base.model.sop.category.SmallClassUserGrade">
		Select * from so_ctgry_sclas_user_grad
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertSmallClassUserGrade" parameterType="egovframework.base.model.sop.category.SmallClassUserGrade">
		INSERT INTO so_ctgry_sclas_user_grad (sclas_sn, grad_sn)
		VALUES (#{sclas_sn}, #{grad_sn})
	</insert>

	<insert id="insertSmallClassUserGrades" parameterType="java.util.List">
		INSERT INTO so_ctgry_sclas_user_grad (sclas_sn, grad_sn)
		VALUES
		<foreach collection="list" item="smallClassUserGrade" separator=",">
			(
				(#{smallClassUserGrade.sclas_sn}, #{smallClassUserGrade.grad_sn})
			)
		</foreach>
	</insert>

	<update id="updateSmallClassUserGradeByCondition" parameterType="map">
		UPDATE so_ctgry_sclas_user_grad
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteSmallClassUserGrade" parameterType="egovframework.base.model.sop.category.SmallClassUserGrade">
		DELETE FROM so_ctgry_sclas_user_grad
		<where>
			sclas_sn = #{sclas_sn}, grad_sn = #{grad_sn}
		</where>
	</delete>

	<delete id="deleteSmallClassUserGradeByCondition" parameterType="map">
		DELETE FROM so_ctgry_sclas_user_grad
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
