<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="facilityManagerTemporaryMapper">

	<select id="selectFacilityManagerTemporaries" parameterType="map" resultType="egovframework.base.model.sensor.FacilityManagerTemporary">
		Select * from fa_sensor_fclty_mgr_tmpr
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertFacilityManagerTemporary" parameterType="egovframework.base.model.sensor.FacilityManagerTemporary">
		INSERT INTO fa_sensor_fclty_mgr_tmpr (fclty_mgr_sn, tmpr_sn)
		VALUES (#{fclty_mgr_sn}, #{tmpr_sn})
	</insert>

	<insert id="insertFacilityManagerTemporaries" parameterType="java.util.List">
		INSERT INTO fa_sensor_fclty_mgr_tmpr (fclty_mgr_sn, tmpr_sn)
		VALUES
		<foreach collection="list" item="facilityManagerTemporary" separator=",">
			(
				(#{facilityManagerTemporary.fclty_mgr_sn}, #{facilityManagerTemporary.tmpr_sn})
			)
		</foreach>
	</insert>

	<update id="updateFacilityManagerTemporaryByCondition" parameterType="map">
		UPDATE fa_sensor_fclty_mgr_tmpr
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteFacilityManagerTemporary" parameterType="egovframework.base.model.sensor.FacilityManagerTemporary">
		DELETE FROM fa_sensor_fclty_mgr_tmpr
		<where>
			fclty_mgr_sn = #{fclty_mgr_sn}, tmpr_sn = #{tmpr_sn}
		</where>
	</delete>

	<delete id="deleteFacilityManagerTemporaryByCondition" parameterType="map">
		DELETE FROM fa_sensor_fclty_mgr_tmpr
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
