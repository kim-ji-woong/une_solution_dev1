<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="zoneDataMapper">

	<select id="selectZoneDatas" parameterType="map" resultType="egovframework.base.model.spatial.ZoneData">
		Select * from sp_zone_data
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertZoneData" parameterType="egovframework.base.model.spatial.ZoneData">
		INSERT INTO sp_zone_data (zone_sn, fake_wall_elev, poi_elev)
		VALUES (#{zone_sn}, #{fake_wall_elev}, #{poi_elev})
	</insert>

	<insert id="insertZoneDatas" parameterType="java.util.List">
		INSERT INTO sp_zone_data (zone_sn, fake_wall_elev, poi_elev)
		VALUES
		<foreach collection="list" item="zoneData" separator=",">
			(
				(#{zoneData.zone_sn}, #{zoneData.fake_wall_elev}, #{zoneData.poi_elev})
			)
		</foreach>
	</insert>

	<update id="updateZoneData" parameterType="egovframework.base.model.spatial.ZoneData">
		UPDATE sp_zone_data
		SET fake_wall_elev = #{fake_wall_elev}, poi_elev = #{poi_elev}
		<where>
			zone_sn = #{zone_sn}
		</where>
	</update>

	<update id="updateZoneDataByCondition" parameterType="map">
		UPDATE sp_zone_data
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteZoneData" parameterType="egovframework.base.model.spatial.ZoneData">
		DELETE FROM sp_zone_data
		<where>
			zone_sn = #{zone_sn}
		</where>
	</delete>

	<delete id="deleteZoneDataByCondition" parameterType="map">
		DELETE FROM sp_zone_data
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
