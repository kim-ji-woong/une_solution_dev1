<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="facilityManagerRegularMapper">

	<select id="selectFacilityManagerRegulars" parameterType="map" resultType="egovframework.base.model.sensor.FacilityManagerRegular">
		Select * from fa_sensor_fclty_mgr_rgl
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertFacilityManagerRegular" parameterType="egovframework.base.model.sensor.FacilityManagerRegular">
		INSERT INTO fa_sensor_fclty_mgr_rgl (fclty_mgr_sn, rgl_sn)
		VALUES (#{fclty_mgr_sn}, #{rgl_sn})
	</insert>

	<insert id="insertFacilityManagerRegulars" parameterType="java.util.List">
		INSERT INTO fa_sensor_fclty_mgr_rgl (fclty_mgr_sn, rgl_sn)
		VALUES
		<foreach collection="list" item="facilityManagerRegular" separator=",">
			(
				(#{facilityManagerRegular.fclty_mgr_sn}, #{facilityManagerRegular.rgl_sn})
			)
		</foreach>
	</insert>

	<update id="updateFacilityManagerRegularByCondition" parameterType="map">
		UPDATE fa_sensor_fclty_mgr_rgl
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteFacilityManagerRegular" parameterType="egovframework.base.model.sensor.FacilityManagerRegular">
		DELETE FROM fa_sensor_fclty_mgr_rgl
		<where>
			fclty_mgr_sn = #{fclty_mgr_sn}, rgl_sn = #{rgl_sn}
		</where>
	</delete>

	<delete id="deleteFacilityManagerRegularByCondition" parameterType="map">
		DELETE FROM fa_sensor_fclty_mgr_rgl
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
