<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="processRegularMapper">

	<select id="selectProcessRegulars" parameterType="map" resultType="egovframework.base.model.sop.component.ProcessRegular">
		Select * from so_compn_procs_rgl
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertProcessRegular" parameterType="egovframework.base.model.sop.component.ProcessRegular">
		INSERT INTO so_compn_procs_rgl (compn_sn, rgl_sn)
		VALUES (#{compn_sn}, #{rgl_sn})
	</insert>

	<insert id="insertProcessRegulars" parameterType="java.util.List">
		INSERT INTO so_compn_procs_rgl (compn_sn, rgl_sn)
		VALUES
		<foreach collection="list" item="processRegular" separator=",">
			(
				(#{processRegular.compn_sn}, #{processRegular.rgl_sn})
			)
		</foreach>
	</insert>

	<update id="updateProcessRegularByCondition" parameterType="map">
		UPDATE so_compn_procs_rgl
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteProcessRegular" parameterType="egovframework.base.model.sop.component.ProcessRegular">
		DELETE FROM so_compn_procs_rgl
		<where>
			compn_sn = #{compn_sn}, rgl_sn = #{rgl_sn}
		</where>
	</delete>

	<delete id="deleteProcessRegularByCondition" parameterType="map">
		DELETE FROM so_compn_procs_rgl
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
