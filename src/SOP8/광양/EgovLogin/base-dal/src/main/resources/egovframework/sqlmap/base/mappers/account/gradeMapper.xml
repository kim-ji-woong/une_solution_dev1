<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC " -//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="gradeMapper">

	<select id="selectGrades" parameterType="map" resultType="egovframework.base.model.account.Grade">
		Select * from acc_grad
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
		<if test="orderBy != null and orderBy != ''">
		ORDER BY ${orderBy}
		</if>
	</select>

	<insert id="insertGrade" parameterType="egovframework.base.model.account.Grade">
		INSERT INTO acc_grad (grad_sn, grad_name)
		VALUES (#{grad_sn}, #{grad_name})
	</insert>

	<insert id="insertGrades" parameterType="java.util.List">
		INSERT INTO acc_grad (grad_sn, grad_name)
		VALUES
		<foreach collection="list" item="grade" separator=",">
			(
				(#{grade.grad_sn}, #{grade.grad_name})
			)
		</foreach>
	</insert>

	<update id="updateGrade" parameterType="egovframework.base.model.account.Grade">
		UPDATE acc_grad
		SET grad_name = #{grad_name}
		<where>
			grad_sn = #{grad_sn}
		</where>
	</update>

	<update id="updateGradeByCondition" parameterType="map">
		UPDATE acc_grad
		SET ${setStatement}
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</update>

	<delete id="deleteGrade" parameterType="egovframework.base.model.account.Grade">
		DELETE FROM acc_grad
		<where>
			grad_sn = #{grad_sn}
		</where>
	</delete>

	<delete id="deleteGradeByCondition" parameterType="map">
		DELETE FROM acc_grad
		<if test="customCondition != null and customCondition != ''">
			WHERE ${customCondition}
		</if>
	</delete>

</mapper>
