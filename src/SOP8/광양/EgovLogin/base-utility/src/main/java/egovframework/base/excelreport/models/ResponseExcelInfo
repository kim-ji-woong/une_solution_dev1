package egovframework.base.excelreport.models;

import egovframework.base.response.MessageResult;

public class ResponseExcelInfo extends MessageResult {
    private byte[] bytes = null;
    private String fileName = null;

    // Getter & Setter
    public byte[] getBytes() {
        return bytes;
    }

    public void setBytes(byte[] bytes) {
        this.bytes = bytes;
    }

    public String getFileName() {
        return fileName;
    }

    public void setFileName(String fileName) {
        this.fileName = fileName;
    }

    // 기본 생성자
    public ResponseExcelInfo() {
        super();
    }

    // 매개변수가 있는 생성자
    public ResponseExcelInfo(boolean success, String message) {
        super(success, message);
    }
}