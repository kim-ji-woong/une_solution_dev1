<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- PLC 계측 CSV(SA00000.csv)가 기록되는 SMB 네트워크 공유 폴더 경로 -->
        <add key="FolderPath" value="\\192.168.0.244\senko"/>
        <!-- 위 공유 폴더 접속 계정 아이디 -->
        <add key="UserName" value="dev1_server2"/>
        <!-- 위 공유 폴더 접속 계정 비밀번호 -->
        <add key="Password" value="9966@"/>
        <!-- CSV를 날짜별 Excel({연도}\{월일}.xlsx)로 백업하는 로컬 루트 경로 -->
        <add key="BackupPath" value="D:\PLC" />
        <!-- 보관기간 초과 데이터 자동 정리(DB 이력 삭제 + 백업 Excel 삭제) 기능 on/off.
             삭제용 tm 인덱스는 앱이 최초 실행 시 자동 생성함. 키가 없으면 기본값 true로 동작 -->
        <add key="RetentionEnabled" value="true" />
        <!-- DB 이력 테이블(his_dust_msrr_data, his_wgr_data) 보관 일수. 기본 730(2년), 초과분은 매일 삭제됨 -->
        <add key="RetentionDays" value="730" />
        <!-- 자동 정리 실행 시각(0~23시). 기본 3(매일 새벽 3시에 1회 실행) -->
        <add key="PurgeHour" value="3" />
        <!-- 1회 실행당 최대 삭제 범위(일 단위). 기본 7, 첫 실행 시 누적된 대량 데이터를 나눠 삭제해 수집 지연을 방지 -->
        <add key="PurgeMaxChunksPerRun" value="7" />
        <!-- 백업 Excel 보관 일수. 기본 1095(3년). RetentionDays보다 작게 설정하면 경고 로그 후 RetentionDays 값으로 자동 보정됨
             (백업은 DB에서 삭제된 데이터의 복구 원본이므로 DB보다 길게 보관해야 함) -->
        <add key="BackupRetentionDays" value="1095" />
    </appSettings>
</configuration>